PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="your_secure_random_jwt_secret_key"
NODE_ENV=production
LIBRETRANSLATE_URL="http://127.0.0.1:5001"

# Rate Limiting Configuration
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_LOGIN_ENDPOINT_MAX=30
RATE_LIMIT_LOGIN_FAIL_MAX=5
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_DICT_MAX=60
RATE_LIMIT_TRANSLATE_MAX=20
RATE_LIMIT_PRACTICE_MAX=90
RATE_LIMIT_EXAM_START_MAX=5
RATE_LIMIT_EXAM_SUBMIT_MAX=5
RATE_LIMIT_PLACEMENT_MAX=5
TRUST_PROXY=1
