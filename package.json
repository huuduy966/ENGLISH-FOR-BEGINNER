{
  "name": "english-for-beginner",
  "version": "1.0.0",
  "description": "English for Beginner (E4B) learning platform",
  "private": true,
  "scripts": {
    "start": "cd server && npm start",
    "build": "npm run build:client",
    "dev": "concurrently -n \"SERVER,CLIENT,TRANSLATE\" -c \"blue,green,magenta\" \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:libretranslate\"",
    "dev:app": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:libretranslate": "cd libretranslate_service && .\\venv\\Scripts\\libretranslate.exe --host 127.0.0.1 --port 5001 --load-only en,vi --disable-files-translation --translation-cache all",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "build:client": "cd client && npm run build",
    "db:push": "cd server && npx prisma db push",
    "db:seed": "cd server && node prisma/seed.js",
    "test:server": "cd server && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
